# Settings for the dashboard. Copy this file to .env and set only what you need;
# every line can stay commented out.
#
# The app reads .env from its own folder when it starts;
# real environment variables win over values in .env.
# Restart the app after a change. Never publish .env: it holds passwords and
# keys (.gitignore keeps it out of git).

# ---------------------------------------------------------------- Server

# Where the app listens. 127.0.0.1 (the default) means this computer only.
# 0.0.0.0 opens it to phones and laptops on the same network.
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000

# Open the browser when the app starts. Set 0 on a computer without a screen.
# OPEN_BROWSER=1

# Where data is kept (state, password hashes, session key, photo cards).
# A relative path is relative to the app folder. Default: data
# DATA_DIR=data

# Announce http://<name>.local:<port> on the network, e.g. MDNS_NAME=dashboard.
# Only with FLASK_HOST=0.0.0.0, and needs `pip install zeroconf`.
# MDNS_NAME=

# ---------------------------------------------------------------- First setup and sign-in

# App name for a fresh install. Normally the first-run page asks for it, and it
# can be changed later in Pengaturan.
# APP_NAME=

# Owner password for a fresh install (8 characters or more). Only read while no
# owner exists yet; remove it after the first start.
# OWNER_PASSWORD=

# Administrator password (8 characters or more). While set, it takes priority
# over data/admin.json and cannot be changed from the web.
# MASTER_ADMIN_PASSWORD=

# Fixed session signing key. Without it a random key is kept in DATA_DIR/session_secret.
# FLASK_SECRET_KEY=

# Set to 1 only when the app sits behind an HTTPS reverse proxy.
# SESSION_COOKIE_SECURE=0

# ---------------------------------------------------------------- Optional AI

# Provider: none (default), ollama, lmstudio, local (any OpenAI-compatible
# server) or anthropic. The AI switch in Pengaturan > Tampilan can also turn it
# on, and then uses Ollama unless a provider is set here.
# STOCK_AI_PROVIDER=none

# Model. Local default: gemma4:e4b. For Claude: haiku (default), sonnet, opus,
# or a full model ID.
# STOCK_AI_MODEL=

# OpenAI-compatible endpoint, when not the default
# (Ollama http://localhost:11434/v1, LM Studio http://localhost:1234/v1).
# STOCK_AI_BASE_URL=

# Key for a local server that needs one (Ollama does not).
# STOCK_AI_API_KEY=

# Claude API key, for the anthropic provider only (needs `pip install anthropic`).
# ANTHROPIC_API_KEY=
